HTTP_ADDR=:8006
KAFKA_BROKERS=kafka:29092
CLICKHOUSE_ADDR=analytic_clickhouse:9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
# Required — empty password is rejected by config.Load.
# If the ClickHouse volume was first created without a password, recreate it:
#   docker compose down && docker volume rm php-project_analytic_chdata
CLICKHOUSE_PASSWORD=analytic_local_secret

# Server-side INSERT batching (session settings on Connect).
# wait=1 makes the server ack only after the async buffer is flushed to disk,
# so a Kafka offset committed after the INSERT is not lost on a CH crash.
CLICKHOUSE_ASYNC_INSERT=1
CLICKHOUSE_WAIT_FOR_ASYNC_INSERT=1
CLICKHOUSE_ASYNC_INSERT_BUSY_TIMEOUT_MS=1000
CLICKHOUSE_ASYNC_INSERT_MAX_DATA_SIZE=10485760
CLICKHOUSE_ASYNC_INSERT_MAX_QUERY_NUMBER=100

# Client-side microbatch (consumers): buffer rows and flush by size or interval.
# Kafka offsets are committed only after the flush succeeds.
CLICKHOUSE_BATCH_MAX_ROWS=500
CLICKHOUSE_BATCH_FLUSH_INTERVAL_MS=1000

# Bound for every ClickHouse query/insert.
CLICKHOUSE_QUERY_TIMEOUT_MS=5000

# Poison pills: malformed messages go to <topic><suffix>; transient errors retry.
KAFKA_DLQ_SUFFIX=.dlq
KAFKA_RETRY_BACKOFF_MS=1000

MIGRATIONS_DIR=migrations
