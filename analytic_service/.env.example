HTTP_ADDR=:8006
KAFKA_BROKERS=kafka:29092
CLICKHOUSE_ADDR=analytic_clickhouse:9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
# Required — empty password is rejected by config.Load.
# If the ClickHouse volume was first created without a password, recreate it:
#   docker compose down && docker volume rm php-project_analytic_chdata
CLICKHOUSE_PASSWORD=analytic_local_secret
# Server-side INSERT batching (session settings on Connect). wait=0 = fire-and-forget.
CLICKHOUSE_ASYNC_INSERT=1
CLICKHOUSE_WAIT_FOR_ASYNC_INSERT=0
CLICKHOUSE_ASYNC_INSERT_BUSY_TIMEOUT_MS=1000
CLICKHOUSE_ASYNC_INSERT_MAX_DATA_SIZE=10485760
CLICKHOUSE_ASYNC_INSERT_MAX_QUERY_NUMBER=100
MIGRATIONS_DIR=migrations
