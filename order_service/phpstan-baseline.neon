parameters:
	ignoreErrors:
		-
			message: '#^Class App\\Models\\Order uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Order.php
		-
			message: '#^Class App\\Models\\OrderItem uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/OrderItem.php
		-
			message: '#^Class App\\Models\\Payment uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Payment.php
		-
			message: '#^Class App\\Models\\ProductSnapshot uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/ProductSnapshot.php
		-
			message: '#^Parameter \#1 \$sessionId of method App\\Contracts\\PaymentGateway\:\:retrieveCheckoutSession\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/Payments/CreateCheckoutService.php
		-
			message: '#^Method Tests\\Feature\\PaymentCheckoutTest\:\:createAwaitingPaymentOrder\(\) should return App\\Models\\Order but returns App\\Models\\Order\|null\.$#'
			identifier: return.type
			count: 1
			path: tests/Feature/PaymentCheckoutTest.php
		-
			message: '#^Cannot call method expectsOutputToContain\(\) on Illuminate\\Testing\\PendingCommand\|int\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Feature/ProductEventsHandlerTest.php
		-
			message: '#^Cannot call method getAttributes\(\) on App\\Models\\ProductSnapshot\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Feature/ProductEventsHandlerTest.php
		-
			message: '#^Cannot access property \$cancel_reason on App\\Models\\Order\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: tests/Feature/StockSagaFlowTest.php
		-
			message: '#^Cannot access property \$status on App\\Models\\Order\|null\.$#'
			identifier: property.nonObject
			count: 6
			path: tests/Feature/StockSagaFlowTest.php
		-
			message: '#^Method Tests\\Feature\\StripeWebhookTest\:\:createOrderWithItem\(\) should return App\\Models\\Order but returns App\\Models\\Order\|null\.$#'
			identifier: return.type
			count: 1
			path: tests/Feature/StripeWebhookTest.php
		-
			message: '#^Parameter \#1 \$sessionId of method App\\Infrastructure\\Stripe\\StripeClient\:\:retrieveCheckoutSession\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Integration/StripeCheckoutAndWebhookFlowTest.php
		-
			message: '#^Parameter \#1 \$sessionId of method App\\Infrastructure\\Stripe\\StripeClient\:\:retrieveCheckoutSession\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Integration/StripeSessionExpiredCompensationTest.php
		-
			message: '#^Cannot access property \$status on App\\Models\\Order\|null\.$#'
			identifier: property.nonObject
			count: 3
			path: tests/Unit/ConfirmOrderFromPaymentTest.php
		-
			message: '#^Cannot access property \$status on App\\Models\\Payment\|null\.$#'
			identifier: property.nonObject
			count: 2
