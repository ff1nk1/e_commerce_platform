		-
			message: '#^Method Tests\\Unit\\StripeWebhookPipelineUnitTest\:\:createOrder\(\) should return App\\Models\\Order but returns App\\Models\\Order\|null\.$#'
			identifier: return.type
			count: 1
			path: tests/Unit/StripeWebhookPipelineUnitTest.php
		-
			message: '#^Cannot access property \$cancel_reason on App\\Models\\Order\|null\.$#'
