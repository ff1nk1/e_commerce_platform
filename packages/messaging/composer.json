{
    "name": "shop/messaging",
    "description": "Shared message envelope, Kafka adapter, and Ecotone outbox/inbox for shop services",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "ecotone/dbal": "^1.328",
        "ecotone/laravel": "^1.328",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "mateusjunges/laravel-kafka": "^2.13",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Shop\\Messaging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shop\\Messaging\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shop\\Messaging\\MessagingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
