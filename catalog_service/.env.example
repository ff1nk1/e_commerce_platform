APP_NAME=CatalogService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://app.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=catalog_service_db
DB_PORT=5432
DB_DATABASE=catalog_db
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/admin-catalog
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=catalog_service_redis
REDIS_PASSWORD=redis_local_secret
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

KAFKA_BROKERS=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CONSUMER_GROUP_ID=catalog-service-orders-v1

# Inbound consumer retries + DLQ publishing (Shop\Messaging\RetryPolicy)
KAFKA_CONSUMER_MAX_ATTEMPTS=5
KAFKA_CONSUMER_RETRY_BASE_MS=1000
KAFKA_CONSUMER_RETRY_MAX_MS=30000
KAFKA_CONSUMER_DLQ_PUBLISH_ATTEMPTS=3
KAFKA_DLQ_SUFFIX=.dlq

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=media
AWS_ENDPOINT=http://catalog-minio:9000
AWS_URL=http://catalog_service_minio:9000/media
AWS_USE_PATH_STYLE_ENDPOINT=true
MEDIA_PUBLIC_BASE=/storage

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
