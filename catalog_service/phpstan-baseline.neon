parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property \(object\|string\|null\)\:\:\$id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Requests/UpdateCategoryRequest.php

		-
			message: '#^Parameter \#3 \$work of method App\\Services\\Saga\\SagaStepRunner\:\:run\(\) expects callable\(\)\: array\{status\?\: string, result\?\: array\<string, mixed\>\}, Closure\(\)\: \(array\{status\: ''done'', result\: array\{order_id\: int\|string, outcome\?\: ''skipped_after_release''\}\}\|null\) given\.$#'
			identifier: argument.type
			count: 1
			path: app/Kafka/Handlers/StockCommitHandler.php

		-
			message: '#^Parameter \#3 \$work of method App\\Services\\Saga\\SagaStepRunner\:\:run\(\) expects callable\(\)\: array\{status\?\: string, result\?\: array\<string, mixed\>\}, Closure\(\)\: \(array\{status\: ''done'', result\: array\{order_id\: int\|string, outcome\?\: ''skipped_after_commit''\}\}\|null\) given\.$#'
			identifier: argument.type
			count: 1
			path: app/Kafka/Handlers/StockReleaseHandler.php

		-
			message: '#^Class App\\Models\\OutboxEvent uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/OutboxEvent.php

		-
			message: '#^Anonymous function never returns float so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: app/Models/Stock.php

		-
			message: '#^Method App\\Models\\Stock\:\:available\(\) return type with generic class Illuminate\\Database\\Eloquent\\Casts\\Attribute does not specify its types\: TGet, TSet$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Stock.php

		-
			message: '#^Property App\\Models\\User\:\:\$id \(int\<0, max\>\) does not accept int\.$#'
