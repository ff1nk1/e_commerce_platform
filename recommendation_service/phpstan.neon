includes:
    - ../tools/phpstan/base.neon
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    tmpDir: ../.phpstan.cache.local/recommendation_service

    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
        - tests

    excludePaths:
        - vendor/*
        - storage/*
        - bootstrap/cache/*
        - node_modules/*
        - public/*
        - _ide_helper.php (?)
        - _ide_helper_models.php (?)
