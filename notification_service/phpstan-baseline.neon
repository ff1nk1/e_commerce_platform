parameters:
	ignoreErrors:

		-
			message: '#^Parameter \#1 \$string of function rtrim expects string, bool\|string given\.$#'
			identifier: argument.type
			count: 1
			path: config/filesystems.php

		-
			message: '#^Cannot access property \$retries on App\\Models\\Notification\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: tests/Feature/NotificationsApiTest.php

		-
			message: '#^Strict comparison using \=\=\= between 1 and 1 will always evaluate to true\.$#'
			identifier: identical.alwaysTrue
			count: 2
			path: tests/Unit/NotificationTest.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 2
			path: tests/Unit/NotificationTest.php
