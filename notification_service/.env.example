APP_NAME=NotificationService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=notification_service_db
DB_PORT=5432
DB_DATABASE=notification_db
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MONGODB_HOST=notification_service_mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=notification_db
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root
MONGODB_AUTHENTICATION_DATABASE=admin

KAFKA_BROKERS=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CONSUMER_GROUP_ID=notification-service-consumers-v1
KAFKA_CONSUMER_GROUP_USER=notification-service-consumers-v1
KAFKA_CONSUMER_GROUP_ORDER=notification-service-order-v1
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_TOPIC_USER_EVENTS_DLQ=user.events.dlq
KAFKA_TOPIC_ORDER_EVENTS=order.events
KAFKA_TOPIC_ORDER_EVENTS_DLQ=order.events.dlq

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=notification_service_mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
