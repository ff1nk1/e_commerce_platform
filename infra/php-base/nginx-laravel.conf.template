server {
    listen ${NGINX_PORT};
    server_name _;
    root /var/www/public;
    index index.php;

    client_max_body_size 32m;

    # Long LLM / gateway upstreams (recommendation chat up to ~120s).
    fastcgi_connect_timeout 60s;
    fastcgi_send_timeout 300s;
    fastcgi_read_timeout 300s;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    # Optional: long-running gateway routes served by the dedicated [gateway]
    # php-fpm pool (rendered by entrypoint-http.sh when GATEWAY_FPM_PORT is set).
    # Wildcard include is a no-op when the directory is empty.
    include /etc/nginx/gateway/*.conf;

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
