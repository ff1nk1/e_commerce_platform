APP_NAME=SearchService
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://search_service_app:8005

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# No SQL database — OpenSearch is the only data store.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

KAFKA_BROKERS=kafka:29092
KAFKA_CACHE_DRIVER=array

OPENSEARCH_HOSTS=http://search_opensearch:9200
OPENSEARCH_PRODUCTS_INDEX=products
OPENSEARCH_CATEGORIES_INDEX=categories
OPENSEARCH_TRACK_TOTAL_HITS=10000
OPENSEARCH_REFRESH_ON_WRITE=false
SEARCH_THROTTLE_PER_MINUTE=60

# Honor X-Skip-Analytics only for loadtests (never enable for public clients).
ALLOW_SKIP_ANALYTICS=false

VITE_APP_NAME="${APP_NAME}"
