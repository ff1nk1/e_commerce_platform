<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="LOG_CHANNEL" value="stderr" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_HOST" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="JWT_SECRET" value="test-secret-key-for-phpunit-only" force="true"/>
        <env name="JWT_ALGO" value="HS256" force="true"/>
        <env name="JWT_TTL" value="15" force="true"/>
        <env name="JWT_REFRESH_TTL" value="3600" force="true"/>
        <env name="REDIS_CLIENT" value="predis" force="true"/>
        <env name="REDIS_HOST" value="auth_service_redis" force="true"/>
        <env name="REDIS_PASSWORD" value="redis_local_secret" force="true"/>
        <env name="REDIS_PORT" value="6379" force="true"/>
        <env name="REDIS_DB" value="15" force="true"/>
        <env name="KAFKA_BROKERS" value="kafka:29092"/>
        <!--
            phpdotenv reads $_SERVER before $_ENV, and PHPUnit's force="true"
            only writes $_ENV/putenv. Inside containers the compose environment
            lands in $_SERVER, so mirror the values that must win here.
        -->
        <server name="APP_ENV" value="testing"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_URL" value=""/>
        <server name="DB_HOST" value=""/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="JWT_SECRET" value="test-secret-key-for-phpunit-only"/>
        <server name="JWT_ALGO" value="HS256"/>
        <server name="JWT_TTL" value="15"/>
        <server name="JWT_REFRESH_TTL" value="3600"/>
        <server name="REDIS_CLIENT" value="predis"/>
        <server name="REDIS_HOST" value="auth_service_redis"/>
        <server name="REDIS_PASSWORD" value="redis_local_secret"/>
        <server name="REDIS_PORT" value="6379"/>
        <server name="REDIS_DB" value="15"/>
    </php>
</phpunit>
