APP_NAME=AuthService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://auth_service_app:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=auth_service_db
DB_PORT=5432
DB_DATABASE=auth_db
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=auth_service_redis
REDIS_PASSWORD=redis_local_secret
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# HS256 requires >= 32 bytes (e.g. openssl rand -hex 32)
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=2592000
JWT_ALGO=HS256
# Empty = host-only cookie for app.localhost ( Domains like .localhost are rejected by browsers )
JWT_COOKIE_DOMAIN=
# true when serving the site over HTTPS (Traefik websecure)
JWT_COOKIE_SECURE=true

CATALOG_SERVICE_URL=http://catalog_service_app:8002
NOTIFICATION_SERVICE_URL=http://notification_service_app:8003
ORDER_SERVICE_URL=http://order_service_app:8004
SEARCH_SERVICE_URL=http://search_service_app:8005
ANALYTIC_SERVICE_URL=http://analytic_service_api:8006
RECOMMENDATION_SERVICE_URL=http://recommendation_service_app:8007

KAFKA_BROKERS=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CONSUMER_GROUP_ID=auth-service-producers

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
